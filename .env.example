# Supabase project settings (Settings → API in the Supabase dashboard).
# Copy this file to .env.local and fill in real values once the project
# from dashboard-live-setup.md Phase 2 exists. Until then the app falls
# back to the demo login.
#
# We're reusing the existing "Heliast site" Supabase project
# (kkvqlplqhdtylwryttpi) rather than a dedicated one — the org's free tier
# caps active projects at 2. The dashboard's tables are namespaced with a
# dashboard_ prefix (dashboard_clients, dashboard_daily_traffic, etc.) to
# stay separate from the marketing site's own tables in the same project.
NEXT_PUBLIC_SUPABASE_URL=https://kkvqlplqhdtylwryttpi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtrdnFscGxxaGR0eWx3cnl0dHBpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODczNTg4MzMsImV4cCI6MjEwMjkzNDgzM30.RNpRXBPNlxVkvcNp03G2z7Gj5kAxr2fRosz5sdEAZxA

# Service role key — server-side only, never exposed to the browser.
# Needed starting in Phase 6 (admin connect routes) and Phase 7 (sync cron).
# Get it from Supabase → Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Admin-only connect routes (Phase 6) — visit /api/admin/connect/<platform>
# yourself with ?token=<this value>. Pick any long random string.
ADMIN_ACCESS_TOKEN=

# Vercel Cron sends this automatically as `Authorization: Bearer <value>`
# once it's set here AND in Vercel's env vars — protects /api/cron/sync from
# being triggered by anyone else. Pick any long random string.
CRON_SECRET=

# Google Cloud OAuth app (Phase 3) — console.cloud.google.com → APIs &
# Services → Credentials. Powers both Search Console and Google Ads.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Ads API additionally needs a developer token (Tools & Settings →
# API Center in the Google Ads account) — approval can take a few days.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Meta Developer app (Phase 4) — developers.facebook.com → your app →
# Settings → Basic. Covers Meta Ads, Instagram, and Facebook Page data.
META_APP_ID=
META_APP_SECRET=

# TikTok Developer app (Phase 5) — developers.tiktok.com → Manage Apps.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Anthropic API key (console.anthropic.com → API Keys) — powers the
# Reports tab's "ask for a custom report" feature. Separate from Supabase.
ANTHROPIC_API_KEY=
