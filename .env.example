# Supabase project settings (Settings → API in the Supabase dashboard).
# Copy this file to .env.local and fill in real values once the project
# from dashboard-live-setup.md Phase 2 exists. Until then the app falls
# back to the demo login.
#
# We're reusing the existing "Heliast site" Supabase project
# (kkvqlplqhdtylwryttpi) rather than a dedicated one — the org's free tier
# caps active projects at 2. The dashboard's tables are namespaced with a
# dashboard_ prefix (dashboard_clients, dashboard_daily_traffic, etc.) to
# stay separate from the marketing site's own tables in the same project.
NEXT_PUBLIC_SUPABASE_URL=https://kkvqlplqhdtylwryttpi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtrdnFscGxxaGR0eWx3cnl0dHBpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODczNTg4MzMsImV4cCI6MjEwMjkzNDgzM30.RNpRXBPNlxVkvcNp03G2z7Gj5kAxr2fRosz5sdEAZxA

# Service role key — server-side only, never exposed to the browser.
# Needed starting in Phase 6 (admin connect routes) and Phase 7 (sync cron).
SUPABASE_SERVICE_ROLE_KEY=
